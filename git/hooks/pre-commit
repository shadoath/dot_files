#!/bin/sh
# Global pre-commit hook (git config --global core.hooksPath ~/dot_files/git/hooks).
# 1. Cross-model agent review of the staged diff (no-op for human commits).
# 2. Chain to the repo's own .git/hooks/pre-commit, which core.hooksPath would otherwise hide.

here=$(cd "$(dirname "$0")" && pwd -P)
"$here/agent-review.sh" || exit $?

# A repo whose local hook is a symlink or copy of this file must not re-enter it: -ef catches the
# symlink (same inode), cmp catches a copy, and the env guard catches anything else that loops back.
[ -n "${DOT_FILES_PRE_COMMIT_CHAINED:-}" ] && exit 0
local_hook="$(git rev-parse --git-common-dir)/hooks/pre-commit"
if [ -x "$local_hook" ] && ! [ "$local_hook" -ef "$here/pre-commit" ] && ! cmp -s "$local_hook" "$here/pre-commit"; then
  DOT_FILES_PRE_COMMIT_CHAINED=1 exec "$local_hook" "$@"
fi
exit 0
